{
  "name": "chronicles-of-fortuna-dokapon",
  "version": "1.0.0",
  "description": "Dokapon Kingdom style 2.5D Isometric Pixel RPG Board Game",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check:css": "node scripts/check-css-coverage.cjs",
    "verify": "npm run typecheck && npm run build && npm test && npm run check:css"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
